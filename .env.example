GEMINI_API_KEY=
TRANSLATE_PROVIDER=google  # no key required
OCR_PROVIDER=paddle  # local
INPAINT_PROVIDER=cv2  # telea cleanup
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./apps/api/data
DATABASE_URL=sqlite:///./apps/api/data/komalingo.db
LIBRETRANSLATE_URL=https://libretranslate.com
CORS_ORIGINS=http://localhost:3000
SOURCE_LANG=auto
TARGET_LANG=en

# Upload / job limits
MAX_UPLOAD_BYTES=250000000
MAX_PAGES_PER_CHAPTER=200
JOB_TTL_HOURS=72

# Pipeline tuning
OCR_MIN_CONFIDENCE=0.48
OCR_MIN_AREA=80
INPAINT_RADIUS=3
INPAINT_MASK_PAD=5
TYPESET_FONT=default
SKIP_SFX=false
CONTINUE_ON_PAGE_ERROR=true
TRANSLATION_CACHE_TTL=86400
